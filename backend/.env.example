# LedgerLens Environment Configuration Template
# Copy this template to .env for local development. Never commit real credentials.

APP_NAME=LedgerLens
APP_ENV=development
APP_DEBUG=true

# Main application database (MySQL 8.0+)
DATABASE_URL=mysql+pymysql://ledgerlens_user:CHANGE_ME@localhost:3306/ledgerlens_db

# Dedicated test database (used only for integration tests)
TEST_DATABASE_URL=mysql+pymysql://ledgerlens_test:CHANGE_ME@localhost:3306/ledgerlens_test

# Resource Limits
MAX_UPLOAD_SIZE_MB=10

# Phase 8: Backup and Restore Configuration
BACKUP_DIRECTORY=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_COUNT=20
AUTO_BACKUP_ENABLED=false
