# Copy to .env to override defaults. Every variable is optional.
# SC_CORS_ORIGINS must be a JSON list.
SC_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SC_MAX_UPLOAD_BYTES=5242880
SC_MAX_ROWS=5000
SC_MAX_STATEMENTS=200
SC_CURRENCY=PKR
# SC_RULES_PATH=/absolute/path/to/custom_rules.json
