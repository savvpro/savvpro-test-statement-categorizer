# Non-secret settings. Copy to backend/.env to override. Nothing here is a credential.
DATABASE_URL=sqlite:///./data/app.db
MAX_UPLOAD_MB=5
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Folder served by GET /api/samples/{name}; defaults to the repo's samples/ folder.
# SAMPLES_DIR=../samples
