# Environment variables read by the backend (set them in your shell; .env files are not auto-loaded).
# All are optional; the values below are the defaults. Relative paths resolve from the working directory.
DRIVELEDGER_DB_PATH=data/driveledger.db
DRIVELEDGER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DRIVELEDGER_MAX_UPLOAD_MB=5
DRIVELEDGER_REVIEW_THRESHOLD=0.75
