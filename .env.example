# Backend (all optional; defaults shown)
APP_ENV=development
APP_DATABASE_URL=sqlite:///./data/app.db
APP_CORS_ORIGINS=http://localhost:3000
APP_MAX_UPLOAD_BYTES=5242880
APP_MAX_ROWS=20000
APP_AUTO_THRESHOLD=0.85
APP_MARGIN_THRESHOLD=0.20
APP_DE_MINIMIS_CENTS=250000
APP_CONTRACTOR_1099_CENTS=60000
APP_FUZZY_MIN_RATIO=88
APP_RATE_LIMIT=30/minute
APP_LOG_LEVEL=INFO

# Frontend
API_INTERNAL_URL=http://localhost:8000
